<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="اطلاعات رزرو"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview1"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title1"
        app:strokeColor="#eee" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/line11"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/round_shape_8dp"
        app:layout_constraintLeft_toLeftOf="@id/cardview1"
        app:layout_constraintRight_toLeftOf="@id/line12"
        app:layout_constraintTop_toTopOf="@id/cardview1" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/line12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/round_shape_8dp"
        app:layout_constraintBottom_toBottomOf="@id/line11"
        app:layout_constraintLeft_toRightOf="@id/line11"
        app:layout_constraintRight_toLeftOf="@id/line13"
        app:layout_constraintTop_toTopOf="@id/line11" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/line13"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/round_shape_8dp"
        app:layout_constraintBottom_toBottomOf="@id/line11"
        app:layout_constraintLeft_toRightOf="@id/line12"
        app:layout_constraintRight_toLeftOf="@id/line14"
        app:layout_constraintTop_toTopOf="@id/line11" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/line14"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/round_shape_8dp"
        app:layout_constraintBottom_toBottomOf="@id/line11"
        app:layout_constraintLeft_toRightOf="@id/line13"
        app:layout_constraintRight_toRightOf="@id/cardview1"
        app:layout_constraintTop_toTopOf="@id/line11" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:text="تاریخ ورود:"
        android:textColor="@color/black"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintRight_toRightOf="@id/line14"
        app:layout_constraintTop_toTopOf="@id/line14" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:text="1404/11/21"
        android:textColor="@color/black"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintRight_toRightOf="@id/line13"
        app:layout_constraintTop_toTopOf="@id/line11" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:text="تاریخ خروج:"
        android:textColor="@color/black"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintRight_toRightOf="@id/line12"
        app:layout_constraintTop_toTopOf="@id/line11" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:text="1404/11/25"
        android:textColor="@color/black"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintRight_toRightOf="@id/line11"
        app:layout_constraintTop_toTopOf="@id/line11" />

</androidx.constraintlayout.widget.ConstraintLayout>